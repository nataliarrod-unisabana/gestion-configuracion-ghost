# Plantilla de variables de entorno para Ghost
# Copiar como .env y completar los valores. El .env real nunca se sube al repositorio.

# --- Aplicación ---
GHOST_VERSION=6-alpine
NODE_VERSION=22.23.1
url=http://localhost:2368

# --- Base de datos (Ghost 6 requiere MySQL 8, no es compatible con MySQL 5.x) ---
MYSQL_VERSION=8.4
database__client=mysql
database__connection__host=db
database__connection__port=3306
database__connection__user=ghost
database__connection__password=CAMBIAR_ESTE_VALOR
database__connection__database=ghost_prod

# --- Correo ---
mail__transport=SMTP
mail__options__service=Mailgun
mail__options__auth__user=CAMBIAR_ESTE_VALOR
mail__options__auth__pass=CAMBIAR_ESTE_VALOR

# --- Entorno ---
NODE_ENV=production